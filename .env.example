# ---------------------------------------------------------------------------
# AI Radar configuration (all optional - the app runs fully offline by default)
# ---------------------------------------------------------------------------

# Background scanner
ENABLE_SCHEDULER=true             # start the in-process scan loop with the server
SCAN_INTERVAL_MINUTES=20          # how often every enabled source is polled
SCAN_ON_START=true                # run one scan right after boot
SCAN_CONCURRENCY=6                # parallel HTTP fetches per scan pass
FETCH_TIMEOUT_MS=15000            # per-request timeout
MAX_ITEMS_PER_SOURCE=30           # newest N entries kept per feed per pass
USER_AGENT=ai-radar/1.0 (+https://localhost)

# Store
DATA_DIR=./data                   # where db.json + seed snapshot live
MAX_ARTICLES=4000                 # rolling window, oldest entries are pruned
SEED_ON_EMPTY=true                # bootstrap from data/seed/articles.seed.json

# Storage backend: "auto" (default) | "local" | "blob"
#   auto  -> Vercel Blob when deployed to Vercel (or in a production build with a
#            Blob token available), data/db.json everywhere else
#   local -> always data/db.json (development and self-hosted)
#   blob  -> always Vercel Blob, opt-in even in development
# STORAGE_BACKEND=auto

# Vercel Blob (production persistence, see README "Storage" section).
# Vercel injects BLOB_READ_WRITE_TOKEN automatically once a Blob store is
# connected to the project - only set it here to point a local or self-hosted
# environment at a Blob store. Never commit the token.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx
# BLOB_STORE_PATHNAME=news.json   # document path inside the store
# BLOB_ACCESS=public              # must match the store: public | private

# Conditional-write retry policy (both backends are compare-and-swap only, so a
# lost race is normal). Contention is handled with exponential backoff + jitter;
# if the budget runs out, the change set is written to a durable pending record
# next to the document (news.pending-<id>.json) and merged back on next load.
# STORE_WRITE_ATTEMPTS=5          # attempts per flush, including the first
# STORE_WRITE_BACKOFF_MS=150      # delay before the second attempt; doubles per attempt
# STORE_WRITE_BACKOFF_MAX_MS=2000 # cap for a single backoff delay
# STORE_WRITE_DEADLINE_MS=5000    # wall-clock budget before the fallback runs

# Summarization: "extractive" (offline TextRank, default) or "llm"
SUMMARIZER=extractive
# Optional: enable LLM summaries for high-impact items only.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# LLM_SUMMARY_MIN_IMPACT=70
