{
  "name": "ai-radar",
  "version": "1.0.0",
  "private": true,
  "description": "Continuous AI intelligence radar: scans trusted sources, aggregates, categorizes, summarizes and alerts on the latest AI advancements.",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "scan": "tsx scripts/scan.ts",
    "reindex": "tsx scripts/reindex.ts",
    "seed:export": "tsx scripts/export-seed.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "fast-xml-parser": "^5.11.1",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.14",
    "typescript": "^5.9.3"
  }
}
